LOG_LEVEL=debug

DB_CONNECTION=sqlite
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_DATABASE=database
#DB_USERNAME=root
#DB_PASSWORD=
#DB_COLLATION=utf8mb4_unicode_ci

BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=9999
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend Configuration
RESEND_API_KEY=
RESEND_DOMAIN=valexhub.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JWT_SECRET=SeCrEtKeY

WAVE_DEMO=false

# Add the Google Analytics Property ID (instructions can be found here: https://github.com/spatie/laravel-analytics)
ANALYTICS_PROPERTY_ID=ID_NUM

# BILLING CREDENTIALS
BILLING_PROVIDER=paystack

PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...

PADDLE_VENDOR_ID=999
PADDLE_API_KEY=999
PADDLE_ENV=sandbox
PADDLE_PUBLIC_KEY=test_...
PADDLE_WEBHOOK_SECRET=pdl_...

STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Coolify deployment service (per-server config stored encrypted in coolify_servers table)
COOLIFY_USE_REAL_SERVICE=false
COOLIFY_MOCK_FAILURE_RATE=0
COOLIFY_WEBHOOK_SECRET=                         # generate: openssl rand -hex 32 — embed in Coolify notification webhook URL

HOSTINGER_API_TOKEN=

# Support
SUPPORT_EMAIL=                                  # inbox that receives deployment failure alerts

# ─── Vars injected into every customer deployment ─────────────────────────────
# Coolify 4.1.x does not auto-apply shared project vars to instances.
# We inject all of these ourselves via the Coolify API at deploy time.
# None of these are ever logged — secrets are masked in the Coolify UI.

# Database (shared Postgres — only DB_NAME is unique per deployment, generated automatically)
DEPLOY_DB_HOST=                                 # internal hostname of your Postgres server
DEPLOY_DB_PORT=5432
DEPLOY_DB_USER=
DEPLOY_DB_PASSWORD=

# Redis
DEPLOY_REDIS_URL=                               # e.g. redis://your-redis-host:6379

# Storage — Backblaze B2 (shared across all instances; STORAGE_PREFIX is unique per instance)
DEPLOY_STORAGE_TYPE=b2
DEPLOY_B2_APPLICATION_KEY_ID=
DEPLOY_B2_APPLICATION_KEY=
DEPLOY_B2_BUCKET_ID=
DEPLOY_B2_BUCKET_NAME=
DEPLOY_B2_CDN_BASE_URL=

# Email
DEPLOY_RESEND_API_KEY=                          # leave blank to use log driver in staging

# Bunny Stream (video courses — shared credentials, per-instance library configured in app settings)
DEPLOY_BUNNY_API_KEY=
DEPLOY_BUNNY_STREAM_TOKEN_KEY=
DEPLOY_BUNNY_STREAM_LIBRARY_ID=
DEPLOY_BUNNY_STREAM_CDN_HOSTNAME=
DEPLOY_BUNNY_WEBHOOK_SECRET=

# Central platform URL — deployed instances POST their setup-complete webhook here
DEPLOY_CENTRAL_API_URL=                         # public URL of this Valexhub platform (no trailing slash)
